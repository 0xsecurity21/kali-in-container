# Local configuration and secrets
.env
.env.*
!.env.example

# Legacy project-local SSH material is not used; Compose mounts a selected
# host public key directly from ~/.ssh instead.
.ssh/
.devcontainer/.ssh/
.devcontainer/ssh/*
!.devcontainer/ssh/.gitkeep

# Runtime state and caches from interactive desktop/SSH sessions. These stay on
# the host for persistence but are machine-specific and must not be committed.
home/.cache/
home/.dbus/
home/.ICEauthority
home/.bash_history
home/.vscode-server/
home/.config/dconf/
home/.config/Thunar/
home/.config/xfce4/
home/thinclient_drives/

# Shell history can contain commands with credentials.
home/.config/zsh/.zsh_history

# VPN profiles and credentials
home/vpns/*
!home/vpns/.gitkeep

# Large, host-managed wordlists
home/wordlists/*
!home/wordlists/.gitkeep

# Temporary files
*.log
*.tmp
*.swp
.DS_Store

# Lab artifacts
home/Documents/**/loot/
home/Documents/**/screenshots/
home/Documents/**/evidence/
home/.sudo_as_admin_successful

# Local user workspace and tool state (never part of the repository)
home/Documents/
home/.local/share/
home/.local/bin/wsdump
home/.viminfo
.devcontainer/zsh_history
.devcontainer/zsh_history.example
