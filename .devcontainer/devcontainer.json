{
  "name": "Kali Workstation",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "kali",
  "workspaceFolder": "/home/kali", 
  "remoteUser": "kali",
  "shutdownAction": "stopCompose",
  "forwardPorts": [2222, 3389],
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-azuretools.vscode-docker",
        "ms-vscode.hexeditor"
      ]
    }
  }
}
