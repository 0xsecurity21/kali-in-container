# Container
CONTAINER_NAME=kali-workstation
KALI_HOSTNAME=kali
KALI_USER=kali
KALI_UID=1000
KALI_GID=1000
TZ=Asia/Yangon

# Networking (bound to localhost)
SSH_PORT=2222
XRDP_PORT=3389

# Services
ENABLE_SSH=1
ENABLE_XRDP=0
ENABLE_POSTGRESQL=0
ENABLE_REDIS=0

# Features (requires rebuild when changed)
INSTALL_XRDP=0
