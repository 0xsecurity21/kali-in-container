# Container identity
CONTAINER_NAME=kali-workstation
KALI_HOSTNAME=kali
# Keep the default `kali` user, or set a free KALI_UID when renaming.
KALI_USER=kali
KALI_UID=1000
KALI_GID=1000
TZ=Asia/Yangon

# Optional account password. Only used for console and RDP login; SSH stays
# key-only. Set it in the ignored .env, never here.
KALI_PASSWORD=

# Image architecture: arm64 = native Apple Silicon, amd64 = x86 under emulation.
X_ARCH=arm64

# Networking (published on 127.0.0.1 only)
SSH_PUBLIC_KEY_PATH=${HOME}/.ssh/id_ed25519.pub
SSH_PORT=2222
XRDP_PORT=3389

# Runtime services (recreate the container, no rebuild)
ENABLE_SSH=1
ENABLE_XRDP=0
ENABLE_POSTGRESQL=0
ENABLE_REDIS=0

# Image contents (rebuild with --no-cache after changing)
INSTALL_XRDP=0
INSTALL_PENTEST=1
INSTALL_DEV=0
INSTALL_PROXY=1
